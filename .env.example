# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Supabase Client Configuration (Safe for frontend exposure - public URL & anon/publishable key)
VITE_SUPABASE_URL="https://your-project-id.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-publishable-key-here"

# Supabase Backend Service Role (SERVER-SIDE ONLY - NEVER expose to frontend or start with VITE_)
# Used exclusively in server.ts for administrative user creation, role assignment, and session revocation.
SUPABASE_SERVICE_ROLE_KEY="your-service-role-secret-key-here"
